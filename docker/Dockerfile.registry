# syntax=docker/dockerfile:1.7

ARG VERSION="dev"
ARG VCS_REF="unknown"

FROM --platform=$BUILDPLATFORM node@sha256:ec857ea6bb60cb3d0fa4d97495590c5fe7d51be8572c307b55957eeb06569cf7 AS frontend-build

ARG VERSION
ARG VCS_REF
ENV FSM_UI_VERSION=$VERSION \
    FSM_UI_REVISION=$VCS_REF

WORKDIR /workspace

COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY webpack.config.js tailwind.config.js ./
COPY ui ./ui

RUN npm run build


FROM --platform=$BUILDPLATFORM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS backend-build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace/src

COPY src/go.mod src/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY src ./

# The official Factorio headless binary is currently distributed for Linux amd64.
RUN test "$TARGETOS/$TARGETARCH" = "linux/amd64" \
    || (echo "Only linux/amd64 is supported because Factorio headless is amd64-only" >&2; exit 1)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/factorio-server-manager .


# glibc is required by the official Factorio headless server.
# Runs as non-root user "factorio" (uid 1000) for security.
FROM ubuntu@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944 AS runtime

ARG VERSION
ARG VCS_REF

ENV DEBIAN_FRONTEND=noninteractive \
    FACTORIO_VERSION="" \
    FSM_REQUIRE_PERSISTENT_MOUNTS=true \
    RCON_PASS=""

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl jq tar xz-utils libmimalloc3 \
    && rm -rf /var/lib/apt/lists/*

RUN usermod -l factorio -d /opt/factorio -m ubuntu \
    && usermod --shell /usr/sbin/nologin factorio

WORKDIR /opt/fsm

COPY --from=backend-build /out/factorio-server-manager ./factorio-server-manager
COPY --from=frontend-build /workspace/app/ ./app/
COPY conf.json.example ./conf.json
COPY LICENSE /usr/share/licenses/factorio-server-manager/LICENSE
COPY AI-DISCLOSURE.md /usr/share/doc/factorio-server-manager/AI-DISCLOSURE.md
COPY docker/entrypoint.sh /opt/entrypoint.sh

RUN sed -i 's/\r$//' /opt/entrypoint.sh \
    && chmod 0755 /opt/fsm/factorio-server-manager /opt/entrypoint.sh

RUN mkdir -p /opt/fsm-data /opt/factorio/saves /opt/factorio/mods /opt/factorio/config \
    && chown -R 1000:1000 /opt/fsm /opt/fsm-data /opt/factorio

# Keep volatile metadata after filesystem layers so a new build date does not
# invalidate the package-install cache.
ARG BUILD_DATE="unknown"
ARG SOURCE_URL="https://github.com/Tricade/factorio-server-manager"
LABEL org.opencontainers.image.title="Factorio Server Control" \
      org.opencontainers.image.description="Web UI for managing a persistent Factorio headless server" \
      org.opencontainers.image.source=$SOURCE_URL \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.licenses="MIT" \
      io.factorio-server-control.ai-assisted-development="true" \
      io.factorio-server-control.ai-disclosure="/usr/share/doc/factorio-server-manager/AI-DISCLOSURE.md"

EXPOSE 8080/tcp 34197/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=2m --retries=5 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/ >/dev/null || exit 1

STOPSIGNAL SIGTERM
USER factorio
ENTRYPOINT ["/opt/entrypoint.sh"]
